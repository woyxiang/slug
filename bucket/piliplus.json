{
    "version": "2.2.0",
    "description": "使用Flutter开发的BiliBili第三方客户端",
    "homepage": "https://github.com/bggRGjQaUbCoE/PiliPlus",
    "license": "GPL-3.0-only",
    "url": "https://github.com/bggRGjQaUbCoE/PiliPlus/releases/download/2.2.0/PiliPlus_windows_2.2.0%2B5580_x64_portable.zip",
    "hash": "61e2a1c7bc8b2d1287151c462e41e0cec089972d387bc4babbabbd5ca3440e0b",
    "extract_dir": "PiliPlus-Win",
    "installer": {
        "script": [
            "$targetPath = \"$persist_dir\\piliplus\"",
            "$configPath = \"$env:APPDATA\\com.example\\piliplus\"",
            "ensure $targetPath | Out-Null",
            "$linkType = (Get-Item -Path $configPath -ErrorAction SilentlyContinue).LinkType",
            "if (Test-Path $configPath) {",
            "    if ($linkType -eq 'Junction') {",
            "        Remove-Item -Path $configPath -Force",
            "    } else {",
            "        Get-ChildItem -Path $configPath -Force | Move-Item -Destination $targetPath -Force",
            "        Remove-Item -Path $configPath -Force -Recurse",
            "    }",
            "}",
            "New-Item $configPath -ItemType Junction -Target $targetPath | Out-Null"
        ]
    },
    "bin": "piliplus.exe",
    "shortcuts": [
        [
            "piliplus.exe",
            "PiliPlus"
        ]
    ],
    "notes": [
        "Settings, login state, playback history and the default download directory are stored in %APPDATA%\\com.example\\piliplus, which is redirected to the Scoop persist directory by a junction on install",
        "Crash logs are written to %USERPROFILE%\\Documents\\.pili_logs.json"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/bggRGjQaUbCoE/PiliPlus/releases/latest",
        "regex": "(?s)\"tag_name\":\\s*\"([\\d.]+)\".*?\"assets\":.*?PiliPlus_windows_([\\d.]+)\\+(\\d+)_x64_portable\\.zip"
    },
    "autoupdate": {
        "url": "https://github.com/bggRGjQaUbCoE/PiliPlus/releases/download/$match1/PiliPlus_windows_$match2%2B$match3_x64_portable.zip"
    }
}
